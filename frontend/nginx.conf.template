resolver 127.0.0.11 valid=10s ipv6=off;

# Ce nginx tourne maintenant systématiquement derrière un reverse-proxy TLS
# (Caddy sur Contabo/Oracle) qui lui parle en clair sur le réseau Docker
# interne — $scheme vaut donc toujours "http" ici, même quand le client a
# réellement utilisé HTTPS jusqu'à Caddy. `proxy_set_header X-Forwarded-Proto
# $scheme` écraserait le header que Caddy a déjà posé correctement, faisant
# croire au backend que TOUTE requête est en HTTP (pertinent pour
# ENFORCE_HTTPS et tout code qui lit ce header). On garde la valeur amont
# quand elle existe (déployé derrière Caddy), on ne retombe sur $scheme que
# si absente (accès direct à ce nginx, sans proxy devant).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Variable (pas une valeur littérale) : force nginx à résoudre "backend" via le
    # resolver Docker à CHAQUE requête (mise en cache 10s) plutôt qu'une seule fois
    # au démarrage. Sans ça, un redéploiement qui recrée le container backend seul
    # (nouvelle IP interne) laisse ce proxy pointer vers une IP morte -> 502 jusqu'au
    # prochain restart de ce container-ci.
    set $backend_upstream ${BACKEND_URL};

    location /api/ {
        # proxy_pass avec une valeur littérale ("$backend_upstream/") ne fait PAS le
        # strip automatique du préfixe /api que fait un proxy_pass littéral classique
        # (comportement nginx différent dès que la cible contient une variable) —
        # constaté en prod : le backend recevait "/" pour TOUTE requête /api/*.
        # rewrite...break le fait explicitement avant le proxy_pass (sans URI ici).
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_cache_bypass $http_upgrade;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
    }

    location /socket.io {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_cache_bypass $http_upgrade;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files /index.html =404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/ /index.html;
    }
}
