<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logitrack" android:host="auth" />
            </intent-filter>

            <!-- App Link vérifié (Android Asset Links, voir
                 frontend/public/.well-known/assetlinks.json) : relais OAuth Google
                 natif (audit 2026-08-26). Remplace la dépendance au schéma
                 personnalisé logitrack:// ci-dessus (conservé en repli) — celui-ci
                 nécessite que Chrome accepte de naviguer vers un schéma non-http
                 depuis un script (politique de geste utilisateur) ET que l'OS
                 autorise le navigateur à relancer l'app en arrière-plan (bloqué en
                 pratique sur MIUI même avec les permissions "démarrage
                 automatique" accordées). Un App Link vérifié est intercepté par
                 Android AVANT même que Chrome charge la page — l'OS route
                 directement vers l'app, sans dépendre de ces deux mécanismes. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="169-58-237-88.sslip.io"
                    android:pathPrefix="/auth/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <service
            android:name=".LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- Redémarre le foreground service après un reboot téléphone si un
             tracking était en cours (SharedPreferences tracking_should_be_active).
             Le chauffeur ne doit JAMAIS devoir rouvrir l'app après un redémarrage. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Certains constructeurs (Samsung, Huawei) émettent aussi cet action. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Canal de secours SMS zéro-connectivité (audit terrain 2026-08-27) : reçoit
             les positions relayées par SMS des chauffeurs sans data/WiFi, UNIQUEMENT
             sur le téléphone-passerelle (mode activé explicitement, voir
             GatewaySmsReceiver.PREF_GATEWAY_MODE_ENABLED) — un téléphone chauffeur
             normal ignore tout SMS entrant sans effet de bord. Priorité élevée pour
             recevoir la diffusion même si une app SMS tierce est présente. -->
        <receiver
            android:name=".GatewaySmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Permet à l'app de demander l'exemption d'optimisation batterie (Doze) :
         sans elle, Android (surtout en Doze après quelques minutes d'immobilité)
         suspend le réseau ET la géoloc de l'app en arrière-plan — cause n°1 du
         tracking qui s'arrête. Les surcouches constructeur exigent en plus les
         réglages manuels documentés dans l'app (OEM battery setup guide). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Permet au BootReceiver de relancer le service après un reboot téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Canal de secours SMS zéro-connectivité (audit terrain 2026-08-27), voir
         SmsFallbackManager.java / GatewaySmsReceiver.java. SEND_SMS n'est demandée
         à l'exécution QUE si le chauffeur configure un numéro de passerelle ;
         RECEIVE_SMS n'est demandée QUE sur le téléphone activé en mode passerelle —
         un téléphone chauffeur normal ne déclenche jamais ces invites. Distribution
         hors Play Store (APK interne) : la politique Play sur les permissions SMS
         (réservée aux apps SMS par défaut) ne s'applique pas à ce déploiement. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
</manifest>
