# ═══════════════════════════════════════════════════════════════════════
# Delivery Tracking — VPS Contabo (x86_64, IP directe, sans domaine/TLS)
# Copiez ce fichier en `.env` à côté de docker-compose.contabo.yml sur le
# serveur, puis remplissez chaque valeur.
#
# GÉNÉRER LES SECRETS (à exécuter sur votre machine ou sur le VPS) :
#   JWT_ACCESS_SECRET / JWT_REFRESH_SECRET : openssl rand -hex 64
#   CSRF_SECRET / ENCRYPTION_KEY           : openssl rand -hex 32
#   POSTGRES_PASSWORD / REDIS_PASSWORD     : openssl rand -hex 24
# ═══════════════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────
POSTGRES_USER=delivery_app
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=delivery_tracking

# ── Redis (obligatoire — voir commentaire dans docker-compose.contabo.yml) ──
REDIS_PASSWORD=<openssl rand -hex 24>

# ── JWT / CSRF / Chiffrement ────────────────────────
JWT_ACCESS_SECRET=<openssl rand -hex 64>
JWT_REFRESH_SECRET=<openssl rand -hex 64>
CSRF_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>

# ── URLs publiques ──────────────────────────────────
# HTTPS automatique via Caddy + sslip.io (voir Caddyfile) : remplacez les
# tirets par les 4 octets de l'IP réelle du VPS (169.58.237.88 →
# 169-58-237-88.sslip.io). Ne PAS mettre l'IP nue en http:// ici — les
# cookies (csrf-token, refreshToken) dérivent Secure/SameSite de cette URL
# (voir backend/src/modules/auth/auth.controller.ts) : http:// ici désactive
# Secure et casse le stockage du cookie côté navigateur si l'app est
# effectivement servie en HTTPS derrière Caddy.
CORS_ORIGIN=https://<IP-DU-VPS-tirets>.sslip.io
APP_URL=https://<IP-DU-VPS-tirets>.sslip.io

# Facturation désactivée (mode pilote) — sans ça, MobileMoneyService refuse de
# démarrer en NODE_ENV=production (voir mobile-money.service.ts).
BILLING_ENABLED=false
MOBILE_MONEY_SANDBOX=false

BACKEND_REPLICAS=1

# ── Email (optionnel — laissez vide pour désactiver l'envoi réel) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@deliverytrack.app

# ── Google OAuth (optionnel) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Google Maps (optionnel, geocoding) ──────────────
GOOGLE_MAPS_API_KEY=

# ── Traccar (tourne sur ce même VPS) ────────────────
TRACCAR_USER=admin
TRACCAR_PASSWORD=<changez le mot de passe admin dans traccar/traccar.xml ET ici>

# ── Observabilité (optionnel) ───────────────────────
SENTRY_DSN=
ALERT_SLACK_WEBHOOK=
ALERT_DISCORD_WEBHOOK=
ALERT_ON_ERROR=true
LOG_LEVEL=info

# ── Sauvegardes (optionnel — n'importe quel stockage S3-compatible) ──
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
