# ═══════════════════════════════════════════════════════════════════════
# Delivery Tracking — Oracle Cloud (Always Free, VM Ampere A1 ARM64)
# Copiez ce fichier en `.env` à côté de docker-compose.oracle.yml sur la VM,
# puis remplissez chaque valeur. Voir DEPLOYMENT.md § "Oracle Cloud" pour le
# guide pas à pas complet.
#
# GÉNÉRER LES SECRETS (à exécuter sur votre machine ou sur la VM) :
#   JWT_ACCESS_SECRET / JWT_REFRESH_SECRET : openssl rand -hex 64
#   CSRF_SECRET / ENCRYPTION_KEY           : openssl rand -hex 32
#   POSTGRES_PASSWORD / REDIS_PASSWORD     : openssl rand -hex 24
# ═══════════════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────
POSTGRES_USER=delivery_app
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=delivery_tracking

# ── Redis ───────────────────────────────────────────
REDIS_PASSWORD=<openssl rand -hex 24>

# ── JWT / CSRF / Chiffrement ────────────────────────
JWT_ACCESS_SECRET=<openssl rand -hex 64>
JWT_REFRESH_SECRET=<openssl rand -hex 64>
CSRF_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>

# ── URLs publiques ──────────────────────────────────
# Phase 1 (pas de domaine) : utilisez l'IP publique de la VM.
# Phase 2 (domaine configuré) : remplacez par https://votre-domaine.
CORS_ORIGIN=http://<IP-PUBLIQUE-DE-LA-VM>
APP_URL=http://<IP-PUBLIQUE-DE-LA-VM>

# ── Réplicas backend (défaut 1 — la VM Ampere A1 Always Free a 4 OCPU / 24 Go,
# largement de quoi passer à 2 une fois le reste stabilisé) ──
BACKEND_REPLICAS=1

# ── Email (optionnel — laissez vide pour désactiver l'envoi réel) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@deliverytrack.app

# ── Google OAuth (optionnel) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Google Maps (optionnel, geocoding) ──────────────
GOOGLE_MAPS_API_KEY=

# ── Traccar (bridge GPS, tourne sur cette même VM) ──
TRACCAR_USER=admin
TRACCAR_PASSWORD=<changez le mot de passe admin dans traccar/traccar.xml ET ici>

# ── Observabilité (optionnel) ───────────────────────
SENTRY_DSN=
ALERT_SLACK_WEBHOOK=
ALERT_DISCORD_WEBHOOK=
ALERT_ON_ERROR=true
LOG_LEVEL=info

# ── Sauvegardes (optionnel — Oracle Object Storage est compatible S3) ──
# Créez un bucket + des clés API "Customer Secret Keys" dans Oracle Cloud
# (Identity → Customer Secret Keys) pour BACKUP_S3_ENDPOINT au format :
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
