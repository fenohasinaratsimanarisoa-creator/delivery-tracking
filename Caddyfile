# ─────────────────────────────────────────────────────────────────────────
# Caddy — reverse-proxy devant le frontend, HTTPS automatique (Let's Encrypt).
#
# Pas de domaine acheté : 169-58-237-88.sslip.io est un service de DNS public
# gratuit qui résout automatiquement vers l'IP encodée dans le nom
# (169-58-237-88 → 169.58.237.88, tirets = points) — aucune inscription,
# aucune configuration DNS à faire. Comme c'est un vrai nom de domaine (pas
# une IP nue), Let's Encrypt peut y émettre un certificat normalement, et
# Caddy l'obtient/le renouvelle seul, sans aucune autre configuration.
169-58-237-88.sslip.io {
	reverse_proxy frontend:80
}

# Redirige l'ancien accès par IP nue (favoris/liens déjà partagés en
# http://169.58.237.88) vers le nouveau domaine HTTPS, plutôt que de le
# laisser tomber en 404 maintenant que Caddy est propriétaire du port 80.
http://169.58.237.88 {
	redir https://169-58-237-88.sslip.io{uri} permanent
}

# Domaine propre : pistio.dev (acheté chez Cloudflare Registrar). Prérequis :
# enregistrement DNS A pistio.dev → 169.58.237.88, proxy Cloudflare DÉSACTIVÉ
# (nuage gris, « DNS only »), sinon Caddy ne peut pas obtenir son certificat.
# Caddy obtient/renouvelle seul le certificat Let's Encrypt. Le bloc sslip.io
# reste en parallèle (ancien APK, liens déjà partagés) sans conflit.
pistio.dev {
	reverse_proxy frontend:80
}

# www.pistio.dev → apex (enregistrement A/CNAME www à créer aussi).
www.pistio.dev {
	redir https://pistio.dev{uri} permanent
}
