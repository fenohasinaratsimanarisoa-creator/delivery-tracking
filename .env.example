[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# DeliveryTrack — variables d'environnement
# Source de vérité : render.yaml (déploiement prod) + le code.
# Copier ce fichier en `.env` pour le développement local.
# ─────────────────────────────────────────────────────────────

# Environnement : development | test | staging | production
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Base de données PostgreSQL
DATABASE_URL=postgresql://delivery_user:delivery_pass@localhost:5432/delivery_tracking

# Redis (optionnel en dev ; requis en prod pour rate limiting + révocation)
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────
# Générer : openssl rand -hex 64 (access et refresh DOIVENT être distincts)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Secret des temp-tokens 2FA (si absent, repli sur JWT_ACCESS_SECRET)
JWT_2FA_TEMP_SECRET=change-me-2fa-temp-secret

# ── CSRF ────────────────────────────────────────────────────
# Obligatoire en production. Générer : openssl rand -hex 32
CSRF_SECRET=change-me-csrf-secret

# ── Chiffrement PII au repos ────────────────────────────────
# Obligatoire en production. Générer : openssl rand -hex 32
ENCRYPTION_KEY=change-me-encryption-key

# ── CORS / Cookies ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# Domaine des cookies si API et front sont sur le même domaine (sinon omettre)
# COOKIE_DOMAIN=deliverytrack.app
# Forcer le HTTPS (redirect 301) : true | false
ENFORCE_HTTPS=false

# ── Emails (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM=DeliveryTrack <no-reply@deliverytrack.app>

# ── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Par défaut : ${APP_URL}/api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://deliverytrack.app/api/auth/google/callback

# ── 2FA ─────────────────────────────────────────────────────
TOTP_ISSUER=DeliveryTracking

# ── Observabilité ───────────────────────────────────────────
LOG_LEVEL=debug
# SENTRY_DSN=https://xxxx@sentry.io/xxxx
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx
# ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxx
ALERT_ON_ERROR=false

# ── Billing ─────────────────────────────────────────────────
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ── Traccar GPS Bridge ──────────────────────────────────────
TRACCAR_URL=http://traccar:8082
TRACCAR_WS_PORT=8082
# ⚠️ Changez ces identifiants en production (via l'interface web Traccar) !
TRACCAR_USER=admin
TRACCAR_PASSWORD=admin

# ── Carburant ───────────────────────────────────────────────
FUEL_ANOMALY_THRESHOLD_PERCENT=20

# ── Divers ──────────────────────────────────────────────────
RESET_DATABASE=false
