# Database
DATABASE_URL=postgresql://delivery_user:delivery_pass@localhost:5432/delivery_tracking

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Fuel anomaly threshold
FUEL_ANOMALY_THRESHOLD_PERCENT=20

# Server
PORT=3000
NODE_ENV=development
