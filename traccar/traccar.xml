<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtds/properties.dtd'>
<properties>
    <!-- Database: H2 embedded (file-based) for development -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:/opt/traccar/data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Web server -->
    <entry key='web.port'>8082</entry>
    <entry key='web.address'>0.0.0.0</entry>

    <!-- Geocoding -->
    <entry key='geocoder.enable'>false</entry>

    <!-- ============================================================
         PROTOCOLS ACTIVÉS — Traceurs GPS physiques
         Chaque protocole est sur un port TCP dédié, sans collision.
         Voir TRACCAR_SETUP.md pour la correspondance protocole ↔ modèles.
         ============================================================ -->
    <!-- GT06 / GT02 / GT02D / GT03 / Concox / JM-VL03 etc. -->
    <entry key='gt06.port'>5055</entry>

    <!-- Teltonika FMB / FM / TAVL / GH protocol families -->
    <entry key='teltonika.port'>5056</entry>

    <!-- H02 (modèles génériques chinois, boîtiers économiques) -->
    <entry key='h02.port'>5057</entry>

    <!-- TK103 / TK102 / Coban / ST-901 / ST-90x -->
    <entry key='tk103.port'>5058</entry>

    <!-- Meitrack (MVT-380 / MVT-600 / T1 / P99 / etc.) -->
    <entry key='meitrack.port'>5059</entry>

    <!-- OsmAnd (utile pour tester avec un smartphone en mode "faux traceur") -->
    <entry key='osmand.port'>5060</entry>

    <!-- Lézard (EZ90 / EZ21 / EZ630 / Delta) — aussi courant sur le marché MG -->
    <entry key='l100.port'>5061</entry>

    <!-- Gator / Watch GPS (montres GPS, balises) -->
    <entry key='wristwatch.port'>5062</entry>

    <!-- Naviset / Navtelecom -->
    <entry key='navtelecom.port'>5063</entry>

    <!-- Sanav / Xexun / GStar / GlobalSat (entrée de gamme) -->
    <entry key='xexun.port'>5064</entry>

    <!-- AST (Falcom / AST) -->
    <entry key='ast.port'>5065</entry>

    <!-- Logging -->
    <entry key='logger.level'>ALL</entry>

    <!-- Default admin user (change in production!) -->
    <entry key='users.default'>admin:admin</entry>

    <!-- Position filtering: ~3s dedup window -->
    <entry key='filter.enable'>true</entry>
    <entry key='filter.distance'>5</entry>
    <entry key='filter.future'>300</entry>

    <!-- Coordinate format: decimal degrees -->
    <entry key='coordinates.format'>dd</entry>
</properties>
