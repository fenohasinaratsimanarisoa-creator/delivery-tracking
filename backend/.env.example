# ──────────────────────────────────────────────
# Delivery Tracking — Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Database (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/delivery_tracking?schema=public
DATABASE_URL="postgresql://delivery_user:delivery_pass@localhost:5432/delivery_tracking?schema=public"

# JWT secrets — GENERATE STRONG RANDOM VALUES:
#   openssl rand -base64 32
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-hex-string"
JWT_2FA_TEMP_SECRET="change-me-to-another-random-64-char-hex-string-for-2fa-temp-tokens"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis (optional — for queue/bull)
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# CORS origin (frontend URL)
CORS_ORIGIN="http://localhost:5173"

# CSRF secret — generate with:
#   openssl rand -hex 32
CSRF_SECRET="change-me-csrf-secret"

# Emails (Resend)
# Sign up at https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@deliverytrack.app"
APP_URL="http://localhost:5173"

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# TOTP (2FA) — optional issuer name
TOTP_ISSUER="DeliveryTracking"

# Seed / Super admin (prisma:seed)
# SEED_ADMIN_EMAIL is required to run prisma:seed
# SEED_ADMIN_PASSWORD is optional — if missing, a random password is generated and printed once
# SEED_ADMIN_FIRST_NAME / SEED_ADMIN_LAST_NAME are optional defaults
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Traccar GPS integration
TRACCAR_URL="http://traccar:8082"
TRACCAR_USER="admin"
TRACCAR_PASSWORD="admin"

# ── Tests d'intégration Traccar (traccar-alert-chain.spec.ts, traccar-postgis.spec.ts) ──
# Base Postgres de TEST DÉDIÉE avec PostGIS (jamais la production !). Ces tests font des
# INSERT/DELETE réels. Sans cette variable, les deux suites sont SKIP proprement.
# Le nom de la base DOIT contenir "test" ou "staging" (garde-fou anti-production).
# Exemple de base de test locale : postgis/postgis:16-3.4 (cf. docker-compose.yml / CI).
# TRACCAR_TEST_DATABASE_URL="postgresql://test:test@localhost:5432/delivery_tracking_test"

# ──────────────────────────────────────────────
# Observability / Monitoring
# ──────────────────────────────────────────────

# Sentry DSN (error tracking)
# Sign up at https://sentry.io and create a project
# SENTRY_DSN="https://xxx@xxx.ingest.us.sentry.io/xxxxxx"

# Alert webhook URL (Slack or Discord)
# For Slack: Create a webhook at https://api.slack.com/messaging/webhooks
# For Discord: Create a webhook in Server Settings → Integrations
# ALERT_SLACK_WEBHOOK="https://hooks.slack.com/services/..."
# ALERT_DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."
# ALERT_ON_ERROR=true (set to true to send alerts on 5xx errors)

# Pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# At-rest encryption key (AES-256-GCM)
# Generate with: openssl rand -hex 32
# If empty, column-level encryption for PII (phone, address) is disabled
# ENCRYPTION_KEY="<hex-64-chars>"

# Enforce HTTP to HTTPS redirect (set 'true' behind a TLS-terminating reverse proxy)
# ENFORCE_HTTPS=true
