# ═══════════════════════════════════════════════
# Delivery Tracking — PRODUCTION Configuration
# ═══════════════════════════════════════════════
#
# HOW TO GENERATE SECRETS
# ─────────────────────────
#   JWT secrets (run both):
#     openssl rand -hex 64
#
#   CSRF secret:
#     openssl rand -hex 32
#
#   Encryption key (for any symmetric encryption):
#     openssl rand -hex 32
#
# ──────────────────────────────────────────────

# Database (PostgreSQL) — USE A STRONG PASSWORD
# Create a dedicated user with limited permissions:
#   CREATE USER delivery_app WITH PASSWORD 'strong-password';
#   GRANT CONNECT, SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO delivery_app;
DATABASE_URL="postgresql://delivery_app:strong-password@db.internal:5432/delivery_tracking?schema=public&sslmode=require"

# JWT secrets — USE THE OUTPUT OF: openssl rand -hex 64
JWT_ACCESS_SECRET="<generate: openssl rand -hex 64>"
JWT_REFRESH_SECRET="<generate: openssl rand -hex 64>"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CSRF secret — USE THE OUTPUT OF: openssl rand -hex 32
CSRF_SECRET="<generate: openssl rand -hex 32>"

# Redis (required for BullMQ queue in production)
REDIS_URL="redis://:password@redis.internal:6379"

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN="https://app.deliverytrack.app"

# Emails (Resend)
# Sign up at https://resend.com
RESEND_API_KEY="re_<your-resend-api-key>"
EMAIL_FROM="noreply@deliverytrack.app"
APP_URL="https://app.deliverytrack.app"

# Google OAuth
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add the callback URL to the authorized redirect URIs
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_CALLBACK_URL="https://api.deliverytrack.app/auth/google/callback"

# TOTP (2FA) issuer name
TOTP_ISSUER="DeliveryTracking"

# Fuel anomaly threshold (percentage deviation from theoretical consumption)
FUEL_ANOMALY_THRESHOLD_PERCENT=20

# ──────────────────────────────────────────────
# Observability / Monitoring
# ──────────────────────────────────────────────

# Sentry DSN — error tracking
# https://sentry.io/organizations/<org>/projects/<project>/settings/keys/
# If empty, Sentry is disabled entirely.
SENTRY_DSN="https://xxx@xxx.ingest.us.sentry.io/xxxxxx"

# Alert webhook (Slack or Discord — only one needed)
# ALERT_SLACK_WEBHOOK="https://hooks.slack.com/services/..."
# ALERT_DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."

# Set to "true" to receive alerts on 5xx server errors
ALERT_ON_ERROR=true

# Logging
# Pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Database connection pool size (optional)
DATABASE_POOL_SIZE=10

# At-rest encryption key (AES-256-GCM) — REQUIRED FOR PRODUCTION
# Generate with: openssl rand -hex 32
# Encrypts phone numbers, addresses at the column level via Prisma middleware
ENCRYPTION_KEY="<generate: openssl rand -hex 32>"

# Enforce HTTP→HTTPS redirect (should be 'true' in production)
ENFORCE_HTTPS=true
