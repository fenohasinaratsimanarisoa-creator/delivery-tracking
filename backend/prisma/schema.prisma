generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  dispatcher
  driver
  client
}

enum DeliveryStatus {
  pending
  assigned
  in_progress
  delivered
  failed
  cancelled
}

enum FuelUnit {
  liters
  gallons
}

// Qualité des données GPS ayant servi au calcul du DailyFuelReport.
// 'insufficient' : pas assez de positions (ou déplacement non mesurable < 0.1 km)
// → le rapport est quand même créé avec distanceKm=0 pour ne pas créer de trou
// silencieux dans le référentiel utilisé par crossCheckFuelLogWithGps.
enum GpsDataQuality {
  sufficient
  insufficient
}

// Source d'émission d'une position GPS. Renseigné obligatoirement à l'insertion
// (NOT NULL sans défaut) pour pouvoir déterminer rétroactivement, sur n'importe
// quelle position historique, si elle provient de l'app mobile chauffeur ('phone')
// ou du traceur physique Traccar ('physical_tracker').
enum GpsPositionSource {
  phone
  physical_tracker
}

// Sens de l'écart de consommation pour l'affichage d'une anomalie de consommation.
// 'over' = sur-consommation (conso mesurée > théorique — évoque fuite/vol/problème
// mécanique) ; 'under' = sous-consommation (conso mesurée < théorique — peut évoquer
// un kilométrage manuel surdéclaré, un mauvais réglage de theoreticalConsumption ou
// une erreur de saisie de plein). Le message de notification doit refléter ce sens
// (above/below) au lieu d'affirmer systématiquement un dépassement.
enum ConsumptionDeviationDirection {
  over
  under
}

enum NotificationType {
  delivery_status
  fuel_anomaly
  fuel_gps_coverage_missing
  maintenance_due
  system
  speed_alert
  prolonged_stop
  delay_alert
  device_offline
  geofence_event
  location_mismatch
}

enum NotificationPriority {
  low
  medium
  high
  critical
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum AuditAction {
  profile_update
  password_change
  email_change
  avatar_change
  company_update
  user_invite
  user_revoke_invite
  user_resend_invite
  session_revoke
  company_delete
  google_unlink
  admin_impersonation
}

enum PlatformAdminAction {
  login
  login_2fa_required
  login_success
  logout
  tenant_toggle
  impersonate
  impersonate_stop
  password_change
  settings_update
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  logoUrl   String?   @map("logo_url")
  pilot     Boolean   @default(true) @map("pilot")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users              User[]
  vehicles           Vehicle[]
  drivers            Driver[]
  deliveries         Delivery[]
  fuelLogs           FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  notifications      Notification[]
  settings           CompanySettings?
  fuelSettings       CompanyFuelSettings?
  invitations        Invitation[]
  auditLogs          AuditLog[]
  platformAuditLogs  PlatformAuditLog[]
  subscription       Subscription?
  invoices           Invoice[]
  usageRecords       UsageRecord[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  geofences          Geofence[]
  fuelPriceHistory   FuelPriceHistory[]
  gpsPositions       GpsPosition[]
  dailyFuelReports   DailyFuelReport[]
  vehicleAssignments VehicleAssignmentHistory[]

  @@map("companies")
}

model CompanySettings {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @map("company_id") @db.Uuid
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingEmail          String?  @map("billing_email")
  billingAddress        String?  @map("billing_address")
  billingTaxId          String?  @map("billing_tax_id")
  fuelAnomalyThreshold  Float?   @default(15) @map("fuel_anomaly_threshold")
  speedAlertThreshold   Float?   @default(80) @map("speed_alert_threshold")
  prolongedStopMinutes  Int?     @default(15) @map("prolonged_stop_minutes")
  offlineTimeoutMinutes Int?     @default(10) @map("offline_timeout_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model Geofence {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryId   String?   @map("delivery_id") @db.Uuid
  delivery     Delivery? @relation(fields: [deliveryId], references: [id])
  name         String
  lat          Float
  lng          Float
  radiusMeters Float     @map("radius_meters")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  geofenceEvents GeofenceEvent[]

  @@index([companyId])
  @@index([deliveryId])
  @@map("geofences")
}

model GeofenceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  geofenceId String   @map("geofence_id") @db.Uuid
  geofence   Geofence @relation(fields: [geofenceId], references: [id])
  vehicleId  String   @map("vehicle_id") @db.Uuid
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  deliveryId String   @map("delivery_id") @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  event      String
  latitude   Float?
  longitude  Float?
  timestamp  DateTime @default(now())

  @@index([geofenceId])
  @@index([vehicleId])
  @@index([deliveryId])
  @@index([vehicleId, deliveryId, timestamp])
  @@index([timestamp])
  @@map("geofence_events")
}

model CompanyFuelSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @unique @map("company_id") @db.Uuid
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit                FuelUnit @default(liters)
  anomalyThreshold    Float?   @default(15) @map("anomaly_threshold")
  // Seuil de tolérance du cross-check GPS (ratio kilométrage saisi / distance GPS).
  // Défaut 1.3 = 130% : une distance saisie ne peut dépasser la distance GPS que de
  // 30% avant d'être signalée. L'ancien seuil en dur de 3 (300%) permettait jusqu'à
  // 2.9x de survalorisation invisible (voir crossCheckFuelLogWithGps).
  crossCheckThreshold Float?   @default(1.3) @map("cross_check_threshold")
  defaultFuelPrices   Json?    @map("default_fuel_prices")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("company_fuel_settings")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  refreshTokenHash String?   @map("refresh_token_hash")
  resetTokenId     String?   @unique @map("reset_token_id")
  resetTokenHash   String?   @map("reset_token_hash")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  googleId         String?   @unique @map("google_id")
  avatarUrl        String?   @map("avatar_url")
  totpSecret       String?   @map("totp_secret")
  totpEnabled      Boolean   @default(false) @map("totp_enabled")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  assignedDeliveries    Delivery[]       @relation("AssignedDriverDeliveries")
  clientDeliveries      Delivery[]       @relation("ClientDeliveries")
  driver                Driver?
  notifications         Notification[]
  resolvedNotifications Notification[]   @relation("ResolvedNotifications")
  preferences           UserPreferences?
  sessions              UserSession[]
  auditLogs             AuditLog[]
  sentInvitations       Invitation[]     @relation("SentInvitations")

  @@index([companyId])
  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDeliveryStatus  Boolean  @default(true) @map("email_delivery_status")
  emailFuelAnomaly     Boolean  @default(true) @map("email_fuel_anomaly")
  emailDeliveryDelayed Boolean  @default(true) @map("email_delivery_delayed")
  emailMaintenanceDue  Boolean  @default(false) @map("email_maintenance_due")
  emailSystem          Boolean  @default(true) @map("email_system")
  inAppDeliveryStatus  Boolean  @default(true) @map("in_app_delivery_status")
  inAppFuelAnomaly     Boolean  @default(true) @map("in_app_fuel_anomaly")
  inAppDeliveryDelayed Boolean  @default(true) @map("in_app_delivery_delayed")
  inAppMaintenanceDue  Boolean  @default(true) @map("in_app_maintenance_due")
  inAppSystem          Boolean  @default(true) @map("in_app_system")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String? // user agent / device info
  ip           String? // IP address
  location     String? // approximate location from IP
  lastActivity DateTime @default(now()) @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([userId])
  @@map("user_sessions")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(pending)
  companyId   String           @map("company_id") @db.Uuid
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedById String           @map("invited_by_id") @db.Uuid
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id])
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  companyId String      @map("company_id") @db.Uuid
  action    AuditAction
  metadata  Json? // additional context (old/new values, etc.)
  ip        String?
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")
  company   Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Vehicle {
  id                     String    @id @default(uuid()) @db.Uuid
  brand                  String
  model                  String
  year                   Int
  licensePlate           String    @map("license_plate")
  vin                    String?   @unique
  fuelType               String    @map("fuel_type")
  theoreticalConsumption Float?    @map("theoretical_consumption") // L/100km
  positionSource         String    @default("phone") @map("position_source") // phone | physical_tracker
  traccarDeviceId        String?   @unique @map("traccar_device_id")
  isActive               Boolean   @default(true) @map("is_active")
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  driver             Driver?
  deliveries         Delivery[]
  fuelLogs           FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  gpsPositions       GpsPosition[]
  geofenceEvents     GeofenceEvent[]
  dailyFuelReports   DailyFuelReport[]
  vehicleAssignments VehicleAssignmentHistory[]

  @@unique([companyId, licensePlate])
  @@index([companyId])
  @@map("vehicles")
}

model Driver {
  id            String    @id @default(uuid()) @db.Uuid
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String?
  phone         String?
  licenseNumber String    @map("license_number")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  vehicleId String?  @unique @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  deliveries         Delivery[]
  gpsPositions       GpsPosition[]
  vehicleAssignments VehicleAssignmentHistory[]

  @@unique([companyId, licenseNumber])
  @@index([companyId])
  @@map("drivers")
}

model Delivery {
  id                      String         @id @default(uuid()) @db.Uuid
  title                   String
  description             String?
  pickupAddress           String         @map("pickup_address")
  pickupLat               Float?         @map("pickup_lat")
  pickupLng               Float?         @map("pickup_lng")
  pickupLocationLabel     String?        @map("pickup_location_label")
  deliveryAddress         String         @map("delivery_address")
  deliveryLat             Float?         @map("delivery_lat")
  deliveryLng             Float?         @map("delivery_lng")
  deliveryLocationLabel   String?        @map("delivery_location_label")
  status                  DeliveryStatus @default(pending)
  scheduledDate           DateTime?      @map("scheduled_date")
  completedAt             DateTime?      @map("completed_at")
  deliveryProofLat        Float?         @map("delivery_proof_lat")
  deliveryProofLng        Float?         @map("delivery_proof_lng")
  deliveryProofDistance   Float?         @map("delivery_proof_distance")
  deliveryProofAccuracy   Float?         @map("delivery_proof_accuracy")
  locationMismatch        Boolean        @default(false) @map("location_mismatch")
  mismatchResolved        Boolean        @default(false) @map("mismatch_resolved")
  notes                   String?
  clientPhone             String?        @map("client_phone")
  amount                  Int?
  articlePrice            Int?           @map("article_price")
  productDescription      String?        @map("product_description")
  externalOrderRef        String?        @map("external_order_ref")
  deletedAt               DateTime?      @map("deleted_at")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  publicTrackingRevokedAt DateTime?      @map("public_tracking_revoked_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  driverId String? @map("driver_id") @db.Uuid
  driver   Driver? @relation(fields: [driverId], references: [id])

  assignedDriverId String? @map("assigned_driver_id") @db.Uuid
  assignedDriver   User?   @relation("AssignedDriverDeliveries", fields: [assignedDriverId], references: [id])

  clientId String? @map("client_id") @db.Uuid
  client   User?   @relation("ClientDeliveries", fields: [clientId], references: [id])

  gpsPositions   GpsPosition[]
  notifications  Notification[]
  geofences      Geofence[]
  geofenceEvents GeofenceEvent[]

  @@unique([companyId, externalOrderRef])
  @@index([companyId])
  @@index([companyId, status])
  @@index([status])
  @@index([assignedDriverId])
  @@index([driverId])
  @@index([driverId, status])
  @@index([clientId])
  @@index([deletedAt])
  @@map("deliveries")
}

model GpsPosition {
  id        String   @id @default(uuid()) @db.Uuid
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  altitude  Float?
  accuracy  Float?
  suspect   Boolean  @default(false)
  location  String   @map("location")
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  deliveryId String?   @map("delivery_id") @db.Uuid
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // driverId NULLABLE : une position peut être enregistrée même si AUCUN chauffeur
  // n'était assigné au véhicule au moment du fix GPS (résolu via
  // VehicleAssignmentHistory au timestamp de la position, pas via l'affectation
  // courante). Les positions null-driver restent utilisées pour les calculs par
  // véhicule / carte live / rapports carburant par véhicule, mais sont exclues des
  // calculs par-chauffeur.
  driverId String? @map("driver_id") @db.Uuid
  driver   Driver? @relation(fields: [driverId], references: [id])

  // Source d'émission de la position ('phone' | 'physical_tracker'). NOT NULL sans
  // défaut : le générateur Prisma force donc TypeScript à exiger sa présence dans
  // tout gpsPosition.create()/createMany() (aucun défaut silencieux possible).
  source GpsPositionSource

  @@index([companyId, timestamp])
  @@index([deliveryId])
  @@index([vehicleId])
  @@index([timestamp])
  @@index([vehicleId, timestamp])
  @@index([deliveryId, timestamp])
  @@map("gps_positions")
}

model GpsPositionArchive {
  id         String   @id @default(uuid()) @db.Uuid
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  altitude   Float?
  accuracy   Float?
  suspect    Boolean  @default(false)
  location   String   @map("location")
  timestamp  DateTime
  createdAt  DateTime @map("created_at")
  deliveryId String   @map("delivery_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  driverId   String   @map("driver_id") @db.Uuid
  archivedAt DateTime @default(now()) @map("archived_at")

  @@index([timestamp])
  @@index([vehicleId])
  @@index([deliveryId])
  @@map("gps_positions_archive")
}

/// Historique d'affectation conducteur ↔ véhicule (append-only).
///
/// INVARIANT (documenté, voir la migration SQL) : à un instant T donné, il existe
/// au plus une ligne OUVERTE (unassignedAt IS NULL) par vehicleId ET au plus une
/// ligne ouverte par driverId. Cette contrainte est appliquée :
///  1. en base, par deux index uniques partiels (SQL brut dans la migration —
///     Prisma ne sait pas représenter un index partiel dans le schéma) ;
///  2. en code applicatif : toute réaffectation se fait dans UNE transaction
///     qui ferme (unassignedAt = now()) la ligne ouverte concernée avant d'ouvrir
///     la suivante (jamais l'une sans l'autre).
model VehicleAssignmentHistory {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  assignedAt   DateTime  @map("assigned_at")
  // null = affectation en cours. Renseigné par une transaction qui ferme
  // l'affectation avant d'en ouvrir une nouvelle.
  unassignedAt DateTime? @map("unassigned_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId, assignedAt])
  @@index([driverId, assignedAt])
  @@index([companyId])
  @@map("vehicle_assignment_history")
}

/// Données comptables — jamais supprimées (soft-delete), conservées pour fiscalité.
/// Seule l'entreprise peut être soft-deleted (deletedAt), les lignes FuelLog
/// sont anonymisées via le job company-purge (BullMQ) après le délai de grâce.
model FuelLog {
  id                            String                         @id @default(uuid()) @db.Uuid
  liters                        Float
  kilometers                    Float
  cost                          Float
  fuelUnit                      FuelUnit                       @default(liters) @map("fuel_unit")
  fillDate                      DateTime                       @map("fill_date")
  notes                         String?
  // Deux paires de champs indépendantes : chaque détecteur écrit sa propre paire
  // sans jamais écraser l'autre. anomalyFlag/anomalyReason NE sont PLUS stockés :
  // ils sont dérivés en lecture (consumption OR gps) et exposés en lecture seule
  // dans les DTOs de réponse (voir common/fuel/fuel-anomaly.utils.ts).
  consumptionAnomalyFlag        Boolean                        @default(false) @map("consumption_anomaly_flag")
  consumptionAnomalyReason      String?                        @map("consumption_anomaly_reason")
  // Sens de l'écart (over/under), renseigné UNIQUEMENT quand consumptionAnomalyFlag=true.
  // Permet au frontend d'afficher la direction sans parser le texte du message.
  consumptionDeviationDirection ConsumptionDeviationDirection? @map("consumption_deviation_direction")
  gpsAnomalyFlag                Boolean                        @default(false) @map("gps_anomaly_flag")
  gpsAnomalyReason              String?                        @map("gps_anomaly_reason")
  // Paire dédiée à l'ABSENCE de couverture GPS (gpsKm <= 0 sur la période du cross-check).
  // Sémantiquement distincte de gpsAnomalyFlag : « aucune donnée GPS pour vérifier »
  // ≠ « le GPS contredit le kilométrage ». Écrite par crossCheckFuelLogWithGps, exposée
  // séparément dans l'API (jamais fusionnée dans anomalyFlag) pour que le frontend puisse
  // afficher « non vérifiable » (neutre) vs « anomalie » (rouge).
  gpsCoverageInsufficientFlag   Boolean                        @default(false) @map("gps_coverage_insufficient_flag")
  gpsCoverageInsufficientReason String?                        @map("gps_coverage_insufficient_reason")
  calculatedConsumption         Float?                         @map("calculated_consumption") // L/100km auto-calculated
  createdAt                     DateTime                       @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([fillDate])
  @@map("fuel_logs")
}

/// Données comptables — jamais supprimées (soft-delete), conservées pour fiscalité.
/// Anonymisées via le job company-purge après délai de grâce.
model MaintenanceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  description String?
  mileage     Float?
  cost        Float?
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("maintenance_records")
}

/// Données comptables — jamais supprimées (soft-delete), conservées pour fiscalité.
/// Anonymisées via le job company-purge après délai de grâce.
model DailyFuelReport {
  id                   String         @id @default(uuid()) @db.Uuid
  reportDate           DateTime       @map("report_date")
  driverId             String         @map("driver_id") @db.Uuid
  driverName           String         @map("driver_name")
  vehicleId            String         @map("vehicle_id") @db.Uuid
  vehicle              Vehicle        @relation(fields: [vehicleId], references: [id])
  vehiclePlate         String         @map("vehicle_plate")
  fuelType             String         @map("fuel_type")
  distanceKm           Float          @map("distance_km")
  gpsDataQuality       GpsDataQuality @default(sufficient) @map("gps_data_quality")
  consumptionLPer100Km Float?         @map("consumption_l_per_100km")
  estimatedCost        Float          @map("estimated_cost")
  pricePerLiterUsed    Float?         @map("price_per_liter_used")
  createdAt            DateTime       @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Un rapport par (driverId, vehicleId, reportDate) : un chauffeur qui change de
  // véhicule en cours de journée produit un DailyFuelReport PAR véhicule utilisé,
  // chacun avec les caractéristiques (fuelType/theoreticalConsumption/prix) du
  // véhicule concerné par ce groupe de positions GPS.
  @@unique([driverId, vehicleId, reportDate])
  @@index([companyId, reportDate])
  @@index([driverId, reportDate])
  @@index([vehicleId])
  @@index([vehicleId, reportDate])
  @@map("daily_fuel_reports")
}

/// Données comptables — jamais supprimées (soft-delete), conservées pour fiscalité.
/// Anonymisées via le job company-purge après délai de grâce.
model FuelPriceHistory {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fuelType       String    @map("fuel_type")
  pricePerLiter  Float     @map("price_per_liter")
  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([companyId, fuelType, effectiveFrom])
  @@index([companyId, fuelType, effectiveUntil])
  @@map("fuel_price_history")
}

model Notification {
  id                String               @id @default(uuid()) @db.Uuid
  type              NotificationType
  priority          NotificationPriority @default(medium)
  title             String
  message           String
  link              String? // optional deep-link URL
  digestOnly        Boolean              @default(false) @map("digest_only")
  digestSentAt      DateTime?            @map("digest_sent_at")
  readAt            DateTime?            @map("read_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  resolved          Boolean              @default(false) @map("resolved")
  resolvedAt        DateTime?            @map("resolved_at")
  resolutionComment String?              @map("resolution_comment")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  deliveryId String?   @map("delivery_id") @db.Uuid
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])

  resolvedById String? @map("resolved_by_id") @db.Uuid
  resolvedBy   User?   @relation("ResolvedNotifications", fields: [resolvedById], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@index([companyId, resolved, createdAt])
  @@map("notifications")
}

enum PlanTier {
  free
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
  unpaid
  trialing
}

enum BillingProvider {
  stripe
  mvola
  orange_money
}

enum InvoiceStatus {
  draft
  open
  paid
  uncollectible
  void
}

enum UsageResource {
  delivery
  vehicle
  user
}

model BillingPlan {
  id                    String   @id @default(uuid()) @db.Uuid
  tier                  PlanTier @unique
  name                  String
  description           String?
  price                 Int      @map("price") // cents per interval
  currency              String   @default("EUR")
  interval              String   @default("month") // month | year
  maxVehicles           Int      @default(5) @map("max_vehicles")
  maxDeliveriesPerMonth Int      @default(50) @map("max_deliveries_per_month")
  maxUsers              Int      @default(3) @map("max_users")
  features              Json     @default("[]")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("billing_plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @unique @map("company_id") @db.Uuid
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId               String             @map("plan_id") @db.Uuid
  plan                 BillingPlan        @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(active)
  provider             BillingProvider    @default(stripe)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  mobileMoneyRef       String?            @map("mobile_money_ref")
  currentPeriodStart   DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId    String          @map("subscription_id") @db.Uuid
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber     String          @unique @map("invoice_number")
  amount            Int             @map("amount") // cents
  currency          String          @default("EUR")
  status            InvoiceStatus   @default(draft)
  provider          BillingProvider @default(stripe)
  providerInvoiceId String?         @unique @map("provider_invoice_id")
  paidAt            DateTime?       @map("paid_at")
  pdfUrl            String?         @map("pdf_url")
  pdfData           Bytes?          @map("pdf_data")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model UsageRecord {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart DateTime      @map("period_start")
  periodEnd   DateTime      @map("period_end")
  resource    UsageResource
  count       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, periodStart, resource])
  @@index([companyId, periodStart])
  @@map("usage_records")
}

enum WebhookEvent {
  delivery_status_changed
  delivery_delivered
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyHash    String    @map("key_hash")
  prefix     String    @map("prefix") // first 8 chars for display
  name       String    @map("name")
  scopes     Json      @default("[\"deliveries:read\"]") // ["deliveries:read", "tracking:read"]
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([keyHash])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url       String   @map("url")
  secret    String   @map("secret") // HMAC signing secret
  events    Json     @default("[]") // ["delivery.status_changed", "delivery.delivered"]
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1) @map("version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhooks")
}

model WebhookDelivery {
  id                 String                @id @default(uuid()) @db.Uuid
  webhookId          String                @map("webhook_id") @db.Uuid
  webhook            Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event              String                @map("event")
  payload            Json                  @map("payload")
  status             WebhookDeliveryStatus @default(pending)
  responseStatusCode Int?                  @map("response_status_code")
  responseBody       String?               @map("response_body")
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(5)
  nextRetryAt        DateTime?             @map("next_retry_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  completedAt        DateTime?             @map("completed_at")

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

model PlatformAdmin {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  totpSecret       String?   @map("totp_secret")
  totpEnabled      Boolean   @default(false) @map("totp_enabled")
  isActive         Boolean   @default(true) @map("is_active")
  refreshTokenHash String?   @map("refresh_token_hash")
  resetTokenHash   String?   @map("reset_token_hash")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

model PlatformAuditLog {
  id              String              @id @default(uuid()) @db.Uuid
  adminId         String              @map("admin_id") @db.Uuid
  admin           PlatformAdmin       @relation(fields: [adminId], references: [id])
  action          PlatformAdminAction
  targetCompanyId String?             @map("target_company_id") @db.Uuid
  targetCompany   Company?            @relation(fields: [targetCompanyId], references: [id])
  targetUserId    String?             @map("target_user_id")
  ip              String?
  userAgent       String?             @map("user_agent")
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}
