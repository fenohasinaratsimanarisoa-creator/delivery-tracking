generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // extensions: uuid-ossp is optional - Prisma generates UUIDs natively
}

enum UserRole {
  admin
  dispatcher
  driver
  client
}

enum DeliveryStatus {
  pending
  assigned
  in_progress
  delivered
  failed
  cancelled
}

enum FuelUnit {
  liters
  gallons
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  vehicles          Vehicle[]
  drivers           Driver[]
  deliveries        Delivery[]
  fuelLogs          FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  notifications       Notification[]

  @@map("companies")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  refreshTokenHash String? @map("refresh_token_hash")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  assignedDeliveries Delivery[] @relation("AssignedDriverDeliveries")
  driver            Driver?
  notifications     Notification[]

  @@map("users")
}

model Vehicle {
  id               String  @id @default(uuid()) @db.Uuid
  brand            String
  model            String
  year             Int
  licensePlate     String  @unique @map("license_plate")
  vin              String? @unique
  fuelType         String  @map("fuel_type")
  theoreticalConsumption Float? @map("theoretical_consumption") // L/100km
  isActive         Boolean @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  driver    Driver?
  deliveries Delivery[]
  fuelLogs  FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  gpsPositions      GpsPosition[]

  @@map("vehicles")
}

model Driver {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String?
  phone          String?
  licenseNumber  String   @unique @map("license_number")
  isActive       Boolean  @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  userId    String?  @unique @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])

  vehicleId String?  @unique @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  deliveries   Delivery[]
  gpsPositions GpsPosition[]

  @@map("drivers")
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  pickupAddress   String         @map("pickup_address")
  pickupLat       Float?         @map("pickup_lat")
  pickupLng       Float?         @map("pickup_lng")
  deliveryAddress String         @map("delivery_address")
  deliveryLat     Float?         @map("delivery_lat")
  deliveryLng     Float?         @map("delivery_lng")
  status          DeliveryStatus @default(pending)
  scheduledDate   DateTime?      @map("scheduled_date")
  completedAt     DateTime?      @map("completed_at")
  notes           String?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  driverId String? @map("driver_id") @db.Uuid
  driver   Driver? @relation(fields: [driverId], references: [id])

  assignedDriverId String? @map("assigned_driver_id") @db.Uuid
  assignedDriver   User?   @relation("AssignedDriverDeliveries", fields: [assignedDriverId], references: [id])

  gpsPositions GpsPosition[]
  notifications Notification[]

  @@index([companyId])
  @@index([status])
  @@map("deliveries")
}

model GpsPosition {
  id        String   @id @default(uuid()) @db.Uuid
  latitude  Float
  longitude Float
  speed     Float?
  location  String   @map("location")
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  deliveryId String @map("delivery_id") @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id])

  vehicleId String @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverId  String @map("driver_id") @db.Uuid
  driver    Driver @relation(fields: [driverId], references: [id])

  @@index([deliveryId])
  @@index([vehicleId])
  @@index([timestamp])
  @@map("gps_positions")
}

model FuelLog {
  id              String   @id @default(uuid()) @db.Uuid
  liters          Float
  kilometers      Float
  cost            Float
  fuelUnit        FuelUnit @default(liters) @map("fuel_unit")
  fillDate        DateTime @map("fill_date")
  notes           String?
  anomalyFlag     Boolean  @default(false) @map("anomaly_flag")
  anomalyReason   String?  @map("anomaly_reason")
  calculatedConsumption Float? @map("calculated_consumption") // L/100km auto-calculated
  createdAt       DateTime @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([fillDate])
  @@map("fuel_logs")
}

model MaintenanceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  description String?
  mileage     Float?
  cost        Float?
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vehicleId String @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("maintenance_records")
}

enum NotificationType {
  delivery_status
  fuel_anomaly
  maintenance_due
  system
}

enum NotificationPriority {
  low
  medium
  high
  critical
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  type      NotificationType
  priority  NotificationPriority @default(medium)
  title     String
  message   String
  link      String?            // optional deep-link URL
  readAt    DateTime?          @map("read_at")
  createdAt DateTime           @default(now()) @map("created_at")

  companyId String @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  userId    String? @map("user_id") @db.Uuid
  user      User?   @relation(fields: [userId], references: [id])

  deliveryId String?  @map("delivery_id") @db.Uuid
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}
